# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
DB_HOST=localhost   
DB_NAME=CampusLearning
DB_USER=sa
DB_PASSWORD=123456aA@$
DB_PORT=1433

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_sercert
JWT_EXPIRES_IN=24h

# Socket Configuration
ENABLE_SOCKET=false
SOCKET_CORS_ORIGIN=http://localhost:5004

# CORS Configuration
CORS_ORIGIN=http://localhost:5004

# VNPAY Configuration
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5004/payment/vnpay/callback

# PayPal Configuration
PAYPAL_CLIENT_ID=-
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_RETURN_URL=http://localhost:5004/payment/paypal/success
PAYPAL_CANCEL_URL=http://localhost:5004/payment/paypal/cancel

# Debug Configuration
DEBUG_MODE=true
ALLOW_SAMPLE_DATA=true

# Add Docker configuration for code execution
ENABLE_DOCKER_CODE_EXECUTION=true
DOCKER_CODE_TEMP_DIR=./temp
DOCKER_MAX_CONTAINERS=10
DOCKER_CONTAINER_TIMEOUT=30000
DOCKER_MEMORY_LIMIT_MB=200
DOCKER_CPU_LIMIT=0.5

# Optional: Set Docker host if running in a custom environment
# DOCKER_HOST=unix:///var/run/docker.sock
# DOCKER_HOST=tcp://localhost:2375

# Gemini AI Configuration
GEMINI_API_KEY=
GEMINI_API_MODEL=gemini-2.0-flash
# Other Configuration
LOG_LEVEL=info

EMAIL_USER=
EMAIL_PASSWORD=
